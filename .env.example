# Google OAuth (Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Texto aleatório longo (ex.: openssl rand -hex 32). Criptografa o cookie de sessão.
SESSION_SECRET=
# URL pública do app, sem barra final. Ex.: https://seuapp.com ou http://localhost:9002
APP_URL=
