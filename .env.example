# Firebase (cliente) — Configurações do projeto em
# https://console.firebase.google.com/ > Configurações do projeto > Geral
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (servidor) — JSON completo da service account, em uma linha só.
# Gere em: Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_KEY=

# Cakto — link de checkout do plano ilimitado (produto/oferta configurado no painel da Cakto)
NEXT_PUBLIC_CAKTO_CHECKOUT_URL=

# Cakto — segredo compartilhado pra validar o webhook de confirmação de pagamento.
# Confirme no painel da Cakto como configurar isso (header ou query string) e
# ajuste src/app/api/billing/webhook/cakto/route.ts se o nome do campo for diferente.
CAKTO_WEBHOOK_SECRET=

# Preço do plano ilimitado (opcional — usa o padrão do código se não definido)
PLAN_PRICE_MONTHLY=19.90
PLAN_PRICE_LAUNCH=9.90
